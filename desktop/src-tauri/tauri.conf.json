{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "0.1.0",
  "identifier": "dev.pulse.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "Pulse", "width": 1200, "height": 800, "visible": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": { "../../build/dist/pulse": "backend" }
  }
}
